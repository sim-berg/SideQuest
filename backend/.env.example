PORT=3000
MONGODB_URI=mongodb://localhost:27017/sidequest
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# Public origin of the app — the frontend's URL, which proxies /api and
# /uploads (vite in dev, nginx in the container). Every absolute URL is built
# from it: share links, the og:image that chat apps fetch from the outside, and
# generated achievement badges. In production this is the real https domain.
APP_URL=http://localhost:5173

# Optional: Anthropic API for the pet brain — soul.md generation, pet chat and
# personalized daily quests. Without a key, everything falls back to templates
# and canned replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Optional: Replicate AI badge generation. Without a token, achievements use a
# deterministic transparent SVG fallback badge.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=fofr/sticker-maker
# Model for illustrative side quest scene images shown in the detail modal.
# Without a token, a colorful inline gradient SVG is used instead.
REPLICATE_SCENE_MODEL=black-forest-labs/flux-schnell

# --- Vector search (Qdrant) -------------------------------------------------
# Every quest is embedded and mirrored into Qdrant, which powers
# GET /api/quests/search, GET /api/quests/:id/similar and the near-duplicate
# check when posting a quest. Leave QDRANT_URL empty to switch the whole
# feature off — search then falls back to substring matching.
QDRANT_URL=http://localhost:6343
QDRANT_API_KEY=
QDRANT_COLLECTION=quests
QDRANT_TIMEOUT_MS=10000

# Embedding model. Community model on Replicate, so the version stays pinned;
# it reuses REPLICATE_API_TOKEN above. multilingual-e5-large → 1024 dims.
# Changing the model means changing EMBEDDING_DIMS and using a fresh
# QDRANT_COLLECTION name — vectors of different sizes cannot share one.
REPLICATE_EMBED_MODEL=beautyyuyanli/multilingual-e5-large:a06276a89f1a902d5fc225a9ca32b6e8e6292b7f3b136518878da97c458e2bad
EMBEDDING_DIMS=1024
EMBEDDING_TIMEOUT_MS=60000

# How often the reconciler looks for quests whose index entry is stale.
VECTOR_RECONCILE_INTERVAL_MS=30000
