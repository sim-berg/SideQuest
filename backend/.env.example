PORT=3000
MONGODB_URI=mongodb://localhost:27017/sidequest
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# Public base URL of the backend — used to build absolute URLs for generated
# achievement badge images (served at /uploads).
APP_URL=http://localhost:3000

# Optional: Anthropic API for the pet brain — soul.md generation, pet chat and
# personalized daily quests. Without a key, everything falls back to templates
# and canned replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Optional: Replicate AI badge generation. Without a token, achievements use a
# deterministic transparent SVG fallback badge.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=fofr/sticker-maker
# Model for illustrative side quest scene images shown in the detail modal.
# Without a token, a colorful inline gradient SVG is used instead.
REPLICATE_SCENE_MODEL=black-forest-labs/flux-schnell
