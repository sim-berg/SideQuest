PORT=3000
MONGODB_URI=mongodb://localhost:27017/sidequest
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# Public origin of the app — the frontend's URL, which proxies /api and
# /uploads (vite in dev, nginx in the container). Every absolute URL is built
# from it: share links, the og:image that chat apps fetch from the outside, and
# generated achievement badges. In production this is the real https domain.
APP_URL=http://localhost:5173

# Optional: Replicate AI badge generation. Without a token, achievements use a
# deterministic transparent SVG fallback badge.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=fofr/sticker-maker
# Model for illustrative side quest scene images shown in the detail modal.
# Without a token, a colorful inline gradient SVG is used instead.
REPLICATE_SCENE_MODEL=black-forest-labs/flux-schnell
